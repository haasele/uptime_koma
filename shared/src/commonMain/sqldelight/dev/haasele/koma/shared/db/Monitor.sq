CREATE TABLE monitor (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    active INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    parent_id INTEGER,
    description TEXT,
    interval_seconds INTEGER NOT NULL DEFAULT 60,
    retry_interval_seconds INTEGER NOT NULL DEFAULT 60,
    resend_interval INTEGER NOT NULL DEFAULT 0,
    max_retries INTEGER NOT NULL DEFAULT 0,
    timeout_seconds INTEGER NOT NULL DEFAULT 48,
    upside_down INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    push_token TEXT,
    proxy_id INTEGER,
    weight INTEGER NOT NULL DEFAULT 2000,
    config TEXT NOT NULL DEFAULT '{}',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX monitor_push_token_idx ON monitor(push_token);
CREATE INDEX monitor_parent_idx ON monitor(parent_id);

selectAll:
SELECT * FROM monitor ORDER BY weight DESC, name ASC;

selectById:
SELECT * FROM monitor WHERE id = ?;

selectActive:
SELECT * FROM monitor WHERE active = 1;

selectByPushToken:
SELECT * FROM monitor WHERE push_token = ? AND type = 'push';

selectChildren:
SELECT * FROM monitor WHERE parent_id = ?;

insertMonitor:
INSERT INTO monitor (
    name, type, active, parent_id, description, interval_seconds, retry_interval_seconds,
    resend_interval, max_retries, timeout_seconds, upside_down, push_token, proxy_id,
    weight, config, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMonitor:
UPDATE monitor SET
    name = ?, type = ?, active = ?, parent_id = ?, description = ?, interval_seconds = ?,
    retry_interval_seconds = ?, resend_interval = ?, max_retries = ?, timeout_seconds = ?,
    upside_down = ?, push_token = ?, proxy_id = ?, weight = ?, config = ?, updated_at = ?
WHERE id = ?;

setActive:
UPDATE monitor SET active = ?, updated_at = ? WHERE id = ?;

deleteMonitor:
DELETE FROM monitor WHERE id = ?;

lastInsertedId:
SELECT last_insert_rowid();
