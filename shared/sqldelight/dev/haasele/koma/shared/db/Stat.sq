CREATE TABLE stat_daily (
    monitor_id INTEGER NOT NULL,
    day_ms INTEGER NOT NULL,
    up INTEGER NOT NULL DEFAULT 0,
    down INTEGER NOT NULL DEFAULT 0,
    maintenance INTEGER NOT NULL DEFAULT 0,
    ping_sum REAL NOT NULL DEFAULT 0.0,
    ping_count INTEGER NOT NULL DEFAULT 0,
    ping_min REAL,
    ping_max REAL,
    PRIMARY KEY (monitor_id, day_ms)
);

selectDaily:
SELECT * FROM stat_daily WHERE monitor_id = ? AND day_ms >= ? ORDER BY day_ms ASC;

selectDay:
SELECT * FROM stat_daily WHERE monitor_id = ? AND day_ms = ?;

-- Accumulation happens in a transaction in StatRepository so the schema stays
-- compatible with the SQLite version shipped on older Android releases.
insertDaily:
INSERT OR REPLACE INTO stat_daily (monitor_id, day_ms, up, down, maintenance, ping_sum, ping_count, ping_min, ping_max)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

aggregateSince:
SELECT
    SUM(up) AS upCount,
    SUM(down) AS downCount,
    SUM(ping_sum) AS pingSum,
    SUM(ping_count) AS pingCount
FROM stat_daily WHERE monitor_id = ? AND day_ms >= ?;

deleteByMonitor:
DELETE FROM stat_daily WHERE monitor_id = ?;
